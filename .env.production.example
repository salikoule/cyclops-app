# Copy to .env.production. That file stays off git.
# Use a long password of letters and digits. A symbol here breaks the database URL.

SITE_ADDRESS=cyclops.craftify.works
ANVIL_ORIGIN=https://cyclops.craftify.works
POSTGRES_PASSWORD=

# craftify.works already receives mail at Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=sali@craftify.works
SMTP_PASSWORD=

# Google redirect URI: https://cyclops.craftify.works/_/client_auth_callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft redirect URI: https://cyclops.craftify.works/_/microsoft_auth_callback
# Tenant "common" allows any work or personal Microsoft account.
MICROSOFT_APP_ID=
MICROSOFT_APP_SECRET=
MICROSOFT_TENANT_ID=common
